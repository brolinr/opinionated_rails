# frozen_string_literal: true

require_relative "../lib/opinionated_rails"

# docs/steps.md is generated from the step classes so the reference cannot drift from the code.
module DocsSteps
  PATH = File.expand_path("../docs/steps.md", __dir__)

  def self.render
    steps = OpinionatedRails.step_classes.sort_by { |klass| [ klass.tier == :core ? 0 : 1, klass.id.to_s ] }
    out = +<<~MD
      ---
      title: Step reference
      nav_order: 8
      description: "Reference for every opinionated_rails step: its tier, dependencies and what it does, generated from the code."
      ---

      # Step reference
      {: .no_toc }

      <!-- Generated by `bundle exec rake docs:steps`. Do not edit by hand. -->

      Every step the tool runs. **Core** steps are asked before `rails new` runs; **add-on** steps run afterwards, ordered by their dependencies (`needs`). Use `opinionated_rails list` and `opinionated_rails info STEP_ID` to see the same information in your terminal.

      | Step | Tier | Needs | What it does |
      | --- | --- | --- | --- |
    MD
    steps.each do |step|
      out << "| [`#{step.id}`](##{step.id}) | #{step.tier} | #{needs(step)} | #{step.summary} |\n"
    end
    out << "\n"
    steps.each { |step| out << detail(step) }
    out
  end

  def self.needs(step) = step.needs.empty? ? "none" : step.needs.map { |id| "`#{id}`" }.join(", ")

  def self.detail(step)
    <<~MD
      ## `#{step.id}`
      {: .no_toc }

      #{step.description}

      - **Tier:** #{step.tier}
      - **Needs:** #{needs(step)}
      - **Prompt:** #{prompt(step)}

    MD
  end

  def self.prompt(step)
    text = step.respond_to?(:prompts) ? step.prompts.to_s.strip : ""
    text.empty? || text == "None" ? "none (always runs)" : text.gsub("|", "\\|")
  end
end

namespace :docs do
  desc "Regenerate docs/steps.md from the step classes"
  task :steps do
    File.write(DocsSteps::PATH, DocsSteps.render)
    puts "Wrote #{DocsSteps::PATH}"
  end

  desc "Fail if docs/steps.md is out of date (run `rake docs:steps`)"
  task :check do
    current = File.exist?(DocsSteps::PATH) ? File.read(DocsSteps::PATH, encoding: "UTF-8") : ""
    abort "docs/steps.md is out of date. Run `bundle exec rake docs:steps` and commit the result." unless current == DocsSteps.render
    puts "docs/steps.md is up to date"
  end
end
